---
import IntroDeck from "@/components/intro/intro-deck";
import { getYearsExperience } from "@/components/sections/shared";
import bricolageLatinUrl from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import instrumentSansLatinUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import "@/styles/global.css";

// Generated by scripts/port-intro-diagrams.mjs from the /diagram-design sources in docs/intro-diagrams.
const diagrams = import.meta.glob<string>("../components/intro/diagrams/*.svg", {
	eager: true,
	import: "default",
	query: "?raw",
});
const diagram = (id: string) => diagrams[`../components/intro/diagrams/${id}.svg`];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<meta name="theme-color" content="white" />
		<link rel="preload" href={bricolageLatinUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={instrumentSansLatinUrl} as="font" type="font/woff2" crossorigin />
		<title>Denny Dharmawan | Introduction</title>
		<style is:global>
			@page {
				size: 13.333in 7.5in;
				margin: 0;
			}
			@media print {
				html {
					print-color-adjust: exact;
				}
			}
		</style>
	</head>
	<body>
		<IntroDeck client:load yearsExperience={getYearsExperience()}>
			<Fragment slot="pr-reviewer" set:html={diagram("pr-reviewer")} />
			<Fragment slot="employee-access" set:html={diagram("employee-access")} />
			<Fragment slot="loan-collections" set:html={diagram("loan-collections")} />
			<Fragment slot="lending" set:html={diagram("lending")} />
		</IntroDeck>
	</body>
</html>
