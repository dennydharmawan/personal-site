---
import instrumentSansLatinUrl from "@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url";
import bricolageLatinUrl from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url";
import "@/styles/global.css";

const title = "Page not found | Denny Dharmawan";
const actionClassName =
	"inline-flex min-h-11 items-center justify-center rounded-lg px-4 text-sm font-medium transition-colors";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="white" />
		<link rel="preload" href={bricolageLatinUrl} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={instrumentSansLatinUrl} as="font" type="font/woff2" crossorigin />
		<title>{title}</title>
	</head>
	<body>
		<main class="mx-auto grid min-h-dvh w-[min(1280px,calc(100%-2.5rem))] content-center justify-items-start gap-6 py-20">
			<a href="/" class="inline-flex min-h-11 items-center gap-2 rounded-sm text-zinc-950 transition-colors hover:text-sky-700">
				<img src="/logo-mark.svg" alt="" width="32" height="32" class="size-8" />
				<span class="text-base font-semibold">Denny Dharmawan</span>
			</a>
			<h1 class="max-w-xl font-heading text-4xl font-normal tracking-tight text-balance text-zinc-900 sm:text-5xl">
				Page not found
			</h1>
			<p class="max-w-xl text-base leading-7 text-pretty text-zinc-600">
				This address doesn't match a page on this site. The home page has my work samples,
				experience, and contact details.
			</p>
			<div class="flex flex-wrap gap-3">
				<a href="/" class={`${actionClassName} bg-primary text-primary-foreground hover:bg-zinc-800`}>
					Go to the home page
				</a>
				<a href="/resume.pdf" download class={`${actionClassName} border border-zinc-200 bg-white text-zinc-900 hover:bg-zinc-50`}>
					Download resume
				</a>
			</div>
		</main>
	</body>
</html>
