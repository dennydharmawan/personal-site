---
import VariantSwitcher from "@/components/lab/variant-switcher";
import "@/styles/global.css";

// An empty path list keeps the lab out of the production build.
export function getStaticPaths() {
	return import.meta.env.DEV ? [{ params: { slug: undefined } }] : [];
}
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<title>Lab</title>
	</head>
	<body>
		<VariantSwitcher client:only="react" />
	</body>
</html>
